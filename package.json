{
  "name": "ba-portfolio", "private": true, "version": "1.0.0", "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite --host 0.0.0.0", "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && vite build --ssr src/entry-server.tsx --outDir .ssr && node scripts/prerender.mjs && node scripts/verify-build.mjs",
    "preview": "vite preview --host 0.0.0.0", "verify": "node scripts/verify-build.mjs"
  },
  "dependencies": { "react": "19.3.1", "react-dom": "19.3.1", "lucide-react": "0.577.0", "@fontsource-variable/manrope": "5.3.0", "@fontsource/instrument-serif": "5.3.0" },
  "devDependencies": { "vite": "8.3.6", "@vitejs/plugin-react": "6.2.1", "typescript": "6.0.3", "@types/react": "19.3.0", "@types/react-dom": "19.3.0", "@types/node": "24.19.2", "tailwindcss": "4.3.4", "@tailwindcss/vite": "4.3.4" }
}
